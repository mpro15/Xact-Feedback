import { createContext, useContext, useState, ReactNode } from 'react';

// Define User interface
interface User {
  id: string;
  email: string;
  name?: string;
  company_id?: string;
  role?: string;
  is_onboarded?: boolean;
  account_type?: 'admin' | 'user';
  is_approved?: boolean;
  permissions?: {
    can_manage_users: boolean;
    can_access_analytics: boolean;
    can_send_feedback: boolean;
    can_view_reports: boolean;
  };
}

// Define AuthContext interface
interface AuthContextType {
  user: User | null;
  loading: boolean;
  error: string | null;
  login: (email: string, password: string) => Promise<boolean>;
  signup: (email: string, password: string, name: string, companyName?: string) => Promise<boolean>;
  logout: () => Promise<void>;
  resetPassword: (email: string) => Promise<boolean>;
  companyId: string | null;
}

// Create the auth context
export const AuthContext = createContext<AuthContextType | undefined>(undefined);

// Provider component that wraps app and makes auth available
export const AuthProvider: React.FC<{ children: ReactNode }> = ({ children }) => {
  console.log("AUTH DISABLED: Using mock admin user");
  
  // Create a mock admin user with all permissions
  const mockUser: User = {
    id: 'mock-admin-user-id',
    email: 'admin@example.com',
    name: 'Admin User',
    company_id: 'mock-company-id',
    role: 'admin',
    is_onboarded: true,
    account_type: 'admin',
    is_approved: true,
    permissions: {
      can_manage_users: true,
      can_access_analytics: true,
      can_send_feedback: true,
      can_view_reports: true
    }
  };
  
  // States for authentication
  const [user] = useState<User | null>(mockUser); // Always set to mockUser
  const [loading] = useState<boolean>(false);     // Never loading
  const [error] = useState<string | null>(null);  // Never error
  const [companyId] = useState<string | null>(mockUser.company_id);
  
  // Mock functions for authentication - all succeed immediately
  const login = async (_email: string, _password: string): Promise<boolean> => {
    console.log("AUTH DISABLED: Mock login always succeeds");
    return true;
  };
  
  const signup = async (_email: string, _password: string, _name: string, _companyName?: string): Promise<boolean> => {
    console.log("AUTH DISABLED: Mock signup always succeeds");
    return true;
  };
  
  const logout = async (): Promise<void> => {
    console.log("AUTH DISABLED: Mock logout (no-op)");
    // Do nothing - user remains set to mockUser
  };
  
  const resetPassword = async (_email: string): Promise<boolean> => {
    console.log("AUTH DISABLED: Mock password reset always succeeds");
    return true;
  };
  
  // Provide auth context value
  const value = {
    user,
    loading,
    error,
    login,
    signup,
    logout,
    resetPassword,
    companyId
  };
  
  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
};

// Hook for easy access to the auth context
export const useAuth = () => {
  const context = useContext(AuthContext);
  if (context === undefined) {
    throw new Error('useAuth must be used within an AuthProvider');
  }
  return context;
};
